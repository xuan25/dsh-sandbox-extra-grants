{
  "name": "dsh-sandbox-extra-grants",
  "version": "0.1.0",
  "description": "Sandbox provider decorator: splices per-policy-mode path grants (ro/rw, files, device nodes, directories) into the confined argv in the runner's own dialect",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "src/",
    "test/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/",
    "selftest": "node test/selftest.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox-local": ">=0.2.2-alpha.2",
    "@deepseek-ai/node-addon-system": ">=0.1.2",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3"
  }
}
